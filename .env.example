# Hedera testnet merchant (receives report payments)
# Demo default matches the README example HashScan payments (judge Path A).
# Override with your own 0.0.x account if you will pay yourself (Path B).
# Restart the server after editing this file.
REPORT_PAY_TO=0.0.5823639
HEDERA_NETWORK=testnet

# List price in USDC; testnet settles HBAR equivalent
REPORT_PRICE_USDC=1
# HBAR_USD_PRICE=0.068

# Optional x402 facilitator (Blocky402 testnet)
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_FEE_PAYER=0.0.7162784
X402_NETWORK=hedera:testnet

PORT=4020

# Demo default: true so README HashScan example txs can unlock the PDF more than once.
# Production-like: set false (one on-chain payment → one unlock).
ALLOW_PAYMENT_REUSE=true
